#include "DHT.h"

// ======================
// PIN KOMPONEN
// ======================
#define SOIL_PIN 34
#define DHT_PIN 4
#define RELAY_PIN 26

#define DHTTYPE DHT11

DHT dht(DHT_PIN, DHTTYPE);

// ======================
// UART
// ======================
HardwareSerial Arduino1(1);
HardwareSerial Arduino2(2);

// UART1
#define RXD1 16
#define TXD1 17

// UART2
#define RXD2 33
#define TXD2 25

// ======================
// RELAY
// ======================
#define RELAY_ON LOW
#define RELAY_OFF HIGH

int batasTanahKering = 2500;
int batasTanahBasah = 1800;

float batasSuhuPanas = 32.0;
float batasKelembapanUdaraRendah = 60.0;

bool pompaNyala = false;

void setup() {

  Serial.begin(115200);

  Arduino1.begin(9600, SERIAL_8N1, RXD1, TXD1);
  Arduino2.begin(9600, SERIAL_8N1, RXD2, TXD2);

  dht.begin();

  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);

  Serial.println("ESP32 Ready");
}

void loop() {

  int nilaiTanah = analogRead(SOIL_PIN);

  float suhu = dht.readTemperature();
  float kelembapanUdara = dht.readHumidity();

  bool tanahKering = nilaiTanah > batasTanahKering;
  bool tanahBasah = nilaiTanah < batasTanahBasah;

  bool udaraPanasDanKering = false;

  if (!isnan(suhu) && !isnan(kelembapanUdara)) {
    udaraPanasDanKering =
      (suhu > batasSuhuPanas &&
       kelembapanUdara < batasKelembapanUdaraRendah);
  }

  // ======================
  // LOGIKA POMPA
  // ======================
  if ((tanahKering || udaraPanasDanKering) && !pompaNyala) {

    digitalWrite(RELAY_PIN, RELAY_ON);
    pompaNyala = true;

    Arduino1.println("POMPA_ON");
    Arduino2.println("POMPA_ON");
  }

  else if (tanahBasah && pompaNyala) {

    digitalWrite(RELAY_PIN, RELAY_OFF);
    pompaNyala = false;

    Arduino1.println("POMPA_OFF");
    Arduino2.println("POMPA_OFF");
  }

  // ======================
  // KIRIM DATA SENSOR
  // ======================

  String dataSensor =
      String(nilaiTanah) + "," +
      String(suhu) + "," +
      String(kelembapanUdara);

  Arduino1.println(dataSensor);
  Arduino2.println(dataSensor);

  // ======================
  // TERIMA DARI ARDUINO 1
  // ======================

  if (Arduino1.available()) {

    String pesan = Arduino1.readStringUntil('\n');

    Serial.print("Arduino1 -> ");
    Serial.println(pesan);

    if (pesan == "POMPA_ON") {
      digitalWrite(RELAY_PIN, RELAY_ON);
      pompaNyala = true;
    }

    if (pesan == "POMPA_OFF") {
      digitalWrite(RELAY_PIN, RELAY_OFF);
      pompaNyala = false;
    }
  }

  // ======================
  // TERIMA DARI ARDUINO 2
  // ======================

  if (Arduino2.available()) {

    String pesan = Arduino2.readStringUntil('\n');

    Serial.print("Arduino2 -> ");
    Serial.println(pesan);

    if (pesan == "POMPA_ON") {
      digitalWrite(RELAY_PIN, RELAY_ON);
      pompaNyala = true;
    }

    if (pesan == "POMPA_OFF") {
      digitalWrite(RELAY_PIN, RELAY_OFF);
      pompaNyala = false;
    }
  }

  delay(2000);
}
